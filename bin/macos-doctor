#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
guest_host="${MACOS_VM_HOST:-}"
guest_user="${MACOS_VM_USER:-vm-admin}"
known_hosts="$root_dir/state/macos_known_hosts"
virtualbuddy_app="${VIRTUALBUDDY_APP_PATH:-/Applications/VirtualBuddy.app}"

if [[ -n "$guest_host" && ! "$guest_host" =~ ^[a-zA-Z0-9][a-zA-Z0-9._:-]*$ ]]; then
  echo "Invalid guest host '$guest_host'." >&2
  exit 2
fi
if [[ ! "$guest_user" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
  echo "Invalid guest user '$guest_user'." >&2
  exit 2
fi

fail=0
if [[ "$(uname -m)" == arm64 ]]; then
  echo 'OK host: Apple silicon'
else
  echo 'FAIL host: macOS guests require Apple silicon'
  fail=1
fi

if [[ -d "$virtualbuddy_app" ]]; then
  version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$virtualbuddy_app/Contents/Info.plist" 2>/dev/null || printf unknown)"
  echo "OK host: VirtualBuddy $version"
else
  echo 'FAIL host: VirtualBuddy is not installed'
  fail=1
fi

memory_bytes="$(sysctl -n hw.memsize 2>/dev/null || true)"
if [[ ! "$memory_bytes" =~ ^[0-9]+$ ]] || (( memory_bytes == 0 )); then
  memory_label="$(system_profiler SPHardwareDataType 2>/dev/null | awk -F': ' '/Memory:/ { print $2; exit }')"
  memory_gib="$(awk '{ print $1 }' <<< "$memory_label")"
  if [[ "$memory_gib" =~ ^[0-9]+$ ]]; then
    memory_bytes="$((memory_gib * 1024 * 1024 * 1024))"
  else
    memory_bytes=0
  fi
fi
if (( memory_bytes >= 17179869184 )); then
  echo 'OK host: at least 16 GB RAM'
else
  echo 'WARN host: less than 16 GB RAM; an 8 GB guest will be tight'
fi

if [[ -n "$guest_host" ]]; then
  if [[ ! -f "$known_hosts" ]]; then
    echo 'FAIL guest: no pinned host key; run make macos-bootstrap first'
    fail=1
  else
    ssh_opts=(
      -o "UserKnownHostsFile=$known_hosts"
      -o StrictHostKeyChecking=yes
      -o ForwardAgent=no
      -o ClearAllForwardings=yes
      -o ConnectTimeout=5
    )
    if ssh "${ssh_opts[@]}" "$guest_user@$guest_host" 'true' >/dev/null 2>&1; then
      remote_doctor='/tmp/agent-devbox-doctor.sh'
      scp "${ssh_opts[@]}" "$root_dir/macos/guest-doctor.sh" "$guest_user@$guest_host:$remote_doctor"
      ssh -t "${ssh_opts[@]}" "$guest_user@$guest_host" "chmod 0700 '$remote_doctor'; '$remote_doctor'; result=\$?; rm -f '$remote_doctor'; exit \$result" || fail=1
    else
      echo 'FAIL guest: requested live guest is unreachable'
      echo 'Enable Remote Login for vm-admin, confirm HOST, and retry.'
      fail=1
    fi
  fi
fi

exit "$fail"
